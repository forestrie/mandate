{
	"name": "@mandate/register",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Univocity instance registration and provisioning (FOR-100)",
	"bin": {
		"mandate-register": "./src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./account-read-attestation": "./src/account-read-attestation.ts",
		"./onboard-attestation": "./src/onboard-attestation.ts",
		"./onboard-client": "./src/onboard-client.ts",
		"./provision-mode-d": "./src/provision-mode-d.ts",
		"./reservation-conflict-error": "./src/reservation-conflict-error.ts",
		"./univocity-instance-id": "./src/univocity-instance-id.ts"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:live:provision": "vitest run test/provision-e2e.live.test.ts",
		"test:live:onboard": "vitest run test/onboard-request.live.test.ts"
	},
	"dependencies": {
		"@forestrie/encoding": "^0.5.0",
		"@mandate/privy-admin": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260228.0",
		"@noble/curves": "^1.9.7",
		"@noble/hashes": "^1.7.1",
		"@types/node": "^22",
		"typescript": "^6.0.2",
		"vitest": "^4.1.3"
	}
}
