{
	"env": {
		"prod": {
			"name": "mandate-signer-prod",
			"workers_dev": true,
			"vars": {
				"MANDATE_PRIVY_API_BASE": "REPLACE_WITH_MANDATE_PRIVY_API_BASE",
				"MANDATE_PRIVY_APP_ID": "REPLACE_WITH_MANDATE_PRIVY_APP_ID"
			},
			"ratelimits": [
				{
					"name": "SIGNER_RATE_LIMITER",
					"namespace_id": "1003",
					"simple": {
						"limit": 60,
						"period": 60
					}
				}
			]
		}
	}
}
