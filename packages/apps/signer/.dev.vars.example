# Local dev secrets (copy to .dev.vars; never commit .dev.vars)
MANDATE_SIGNER_TOKEN=replace-with-signer-bearer-token
MANDATE_PRIVY_APP_ID=replace-with-privy-app-id
MANDATE_PRIVY_APP_SECRET=replace-with-privy-app-secret
KEY_DIRECTORY={"test-key":{"walletId":"replace-wallet-id","rootSignerAddress":"0x0000000000000000000000000000000000000001","logIds":["b2c3d4e5f67890ab1234567890abcdef"]}}
# Mode C owned-wallet entry adds requiresAuthorizationSignature: true (see service-secrets.md).
# Optional: owned-wallet live test (pnpm test:live:owned). User-owned signer test wallet
# with mandate as additional signer — distinct from operator ownerless wallet and
# Mode C kill-switch wallet (E2E_MODE_C_USER_*).
# E2E_SIGNER_TEST_PRIVY_WALLET_ID=replace-wallet-id
# E2E_SIGNER_TEST_WALLET_ADDRESS=0x...
# E2E_SIGNER_TEST_OWNER_AUTH_KEY=wallet-auth:... (onboard/re-onboard only)
# Optional: owned-wallet Mode C path (pnpm test:live:owned). `wallet-auth:` +
# base64 PKCS#8 DER P-256 additional-signer key; wallet must be user-owned.
# MANDATE_PRIVY_AUTHORIZATION_KEY=wallet-auth:replace-base64-pkcs8-der
