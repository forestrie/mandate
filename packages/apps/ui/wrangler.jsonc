{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mandate",
	"compatibility_date": "2026-05-24",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"vars": {
		"NODE_ENV": "production",
		"COORDINATOR_AUTH_MODE": "wallet_challenge",
		"COORDINATOR_UPSTREAM_URL": "https://coordinator.forest-2.forestrie.dev",
		"ENABLE_WALLET_CHALLENGE_AUTH": "true",
		"PUBLIC_CANOPY_API_URL": "https://api-a.forest-2.forestrie.dev"
	}
}
