{
	"name": "@mandate/ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "BYOK operator console for Forestrie delegation management",
	"scripts": {
		"dev": "vite dev",
		"build": "CF_PAGES=1 vite build",
		"build:check": "wrangler types --check && CF_PAGES=1 vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "PUBLIC_COORDINATOR_BFF_BASE=/api/coordinator PUBLIC_MANDATE_PRIVY_APP_ID=local PUBLIC_MANDATE_PRIVY_CLIENT_ID=local PUBLIC_DEFAULT_CHAIN_ID=84532 svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run",
		"gen": "wrangler types"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.16.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"clsx": "^2.1.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@forestrie/delegation-cose": "^0.1.3",
		"@forestrie/encoding": "^0.5.0",
		"@mandate/coordinator-types": "workspace:*",
		"@mandate/register": "workspace:*",
		"@noble/curves": "^1.9.7",
		"@noble/hashes": "^1.7.1",
		"@privy-io/js-sdk-core": "^0.65.1",
		"viem": "^2.50.4"
	},
	"exports": {
		"./e2e/mock-client": "./src/lib/privy/mock-client.ts"
	}
}
