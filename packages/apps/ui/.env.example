# Public (safe for client bundle — prefix PUBLIC_)
PUBLIC_COORDINATOR_BFF_BASE=/api/coordinator
PUBLIC_MANDATE_PRIVY_APP_ID=
PUBLIC_MANDATE_PRIVY_CLIENT_ID=
PUBLIC_DEFAULT_CHAIN_ID=84532
# Canopy API base for the fee surface (browser-direct; the attestation aud is
# this URL's origin). Unset ⇒ the Fees page reports itself unconfigured.
PUBLIC_CANOPY_API_URL=https://api-a.forest-2.forestrie.dev
# DEFAULT signing backend (session picker can override): privy (custodial
# embedded wallet) | safe (external wallet + 1-of-1 Safe, Mode D) | burner
# (browser-local key the user controls — demo/system-test only, plan-2607-01/FOR-322).
# Blank or unset ⇒ privy. NEVER set burner for the live mandate-forestrie instance;
# burner is only selectable in the console when configured here.
PUBLIC_MANDATE_SIGNER_BACKEND=privy
# Browser-side JSON-RPC endpoint for Safe validation reads (Mode D, plan-2607-45):
# eth_getCode / getOwners / getThreshold. Must be an endpoint for
# PUBLIC_DEFAULT_CHAIN_ID and safe to expose in the client bundle (keyless).
# Unset ⇒ validation falls back to the connected wallet's own RPC.
PUBLIC_RPC_URL=https://sepolia.base.org
# Default univocity release tag for the /onboard inline deploy branch
# (plan-2607-47). MUST be a concrete tag — never `latest` (an anonymous
# GitHub lookup on the page path is the deploy-web 403 class). Deploy CI
# resolves the newest release; unset ⇒ the operator types a tag.
PUBLIC_UNIVOCITY_RELEASE_TAG=v0.1.8
# Set to true for hermetic Playwright e2e preview build only (see plan-0047)
# VITE_E2E_PRIVY_MOCK=true

# Server-only (Doppler / .dev.vars — never prefix PUBLIC_)
COORDINATOR_APP_TOKEN=
COORDINATOR_UPSTREAM_URL=https://coordinator.forest-2.forestrie.dev
COORDINATOR_AUTH_MODE=app_token_bff
ENABLE_CUSTODY_KEYS_BFF=false

# Operator personality (FOR-493) — all three required or the /instances BFF
# routes answer 501 and the surface is disabled. MANDATE_OPS_UI_TOKEN is the
# console-side credential the operator pastes into /instances (held in
# sessionStorage); MANDATE_CANOPY_OPS_TOKEN is the canopy operator identity
# and never reaches the browser.
MANDATE_OPS_UI_TOKEN=
CANOPY_UPSTREAM_URL=https://api-a.forest-2.forestrie.dev
MANDATE_CANOPY_OPS_TOKEN=

# OPTIONAL GitHub token for the /api/deploy/manifest byte proxy
# (plan-2607-47 Q7a): with it, release assets resolve via the authenticated
# releases API (immune to Cloudflare shared-egress anonymous rate limits);
# without it, the proxy falls back to the public release download URL.
# Needs no scopes beyond public repo read.
MANDATE_GITHUB_TOKEN=
