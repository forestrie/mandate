{
	"name": "@forestrie/mandate-register",
	"version": "0.2.2",
	"license": "MIT",
	"type": "module",
	"description": "Bundled mandate-register CLI for cross-repo system tests (ARC-0024)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/forestrie/mandate.git",
		"directory": "packages/publish/mandate-register"
	},
	"bin": {
		"mandate-register": "./bin/mandate-register.mjs"
	},
	"files": [
		"dist",
		"bin"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "node build.mjs",
		"check": "node build.mjs && test -f dist/cli.js",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build",
		"prepack": "pnpm run build"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@mandate/register": "workspace:*",
		"@mandate/privy-admin": "workspace:*",
		"esbuild": "^0.25.0",
		"typescript": "^6.0.2",
		"vitest": "^4.1.3"
	}
}
